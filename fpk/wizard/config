        "stepTitle": "MDCz 设置",
        "items": [
            {
                "type": "text",
                "field": "wizard_port",
                "label": "Web 访问端口",
                "initValue": "",
                "helpText": "留空表示沿用当前端口。需要更换时填写 1024-65535 之间的新端口；保存后应用会自动重启，桌面入口端口同步更新。",
                "rules": [
                    {
                        "pattern": "^$|^(1[0-9]{3}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                        "message": "留空或填写 1024-65535 之间的端口号"
                    }
                ]
            },
            {
                "type": "tips",
                "helpText": "媒体目录请使用「应用设置 → 授权目录」维护。新增或取消授权后，重新启动一次应用即可生效；MDCz 会以应用用户身份读取这些目录，不再额外申请 root 权限。"
            }
        ]
    }
